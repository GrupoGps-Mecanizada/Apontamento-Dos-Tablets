        function aplicarFiltros() {
            const dataInicial = document.getElementById('dataInicial').value;
            const dataFinal = document.getElementById('dataFinal').value;
            const horaInicial = document.getElementById('horaInicial').value;
            const horaFinal = document.getElementById('horaFinal').value;
            const tipoFilter = document.getElementById('tipoFilter').value;

            dadosFiltrados = dadosCSV.filter(apt => {
                // Filtro de data
                const dataStr = apt['Data Inicial']?.split(' ')[0];
                if(dataStr) {
                    const [day, month, year] = dataStr.split('/');
                    const dataObj = new Date(`${year}-${month}-${day}T00:00:00`);
                    
                    if(dataInicial && dataObj < new Date(dataInicial + 'T00:00:00')) return false;
                    if(dataFinal && dataObj > new Date(dataFinal + 'T00:00:00')) return false;
                } else if(dataInicial || dataFinal) {
                    return false;
                }

                // Filtro de hora
                const horaApt = extrairHora(apt['Data Inicial']);
                if(horaInicial && horaApt && horaApt < horaInicial) return false;
                if(horaFinal && horaApt && horaApt > horaFinal) return false;

                // Filtro de tipo
                if(tipoFilter && getTipoEquipamento(extrairCodigoVaga(apt.Vaga)) !== tipoFilter) return false;

                return true;
            });

            // Aplicar filtro de regime se ativo
            if(regimeAtivo) {
                const config = regimesDisponiveis[regimeAtivo];
                dadosFiltrados = dadosFiltrados.filter(apt => {
                    const codigo = extrairCodigoVaga(apt.Vaga);
                    return config.equipamentos.includes(codigo);
                });
            }

            if(dadosFiltrados.length) {
                detectarApontamentosIrregularesInteligente(dadosFiltrados);
                equipamentosProcessados = processarEquipamentosDoCSV(dadosFiltrados);
                exibirResultadosDashboard();

                if(document.querySelector('.tab-btn.active').getAttribute('onclick').includes('timeline')) {
                    gerarTimelineInteligente();
                }

                showSuccess('Filtros aplicados! ' + dadosFiltrados.length + ' apontamentos encontrados.');
            } else {
                equipamentosProcessados = {};
                apontamentosIrregulares = [];
                exibirResultadosDashboard();
                document.getElementById('timelineContainer').innerHTML = '<div class="timeline-empty">Nenhum dado encontrado com os filtros aplicados.</div>';
                showError('Nenhum apontamento encontrado com os filtros aplicados.');
            }
        }

        // Sistema de exportação automatizada
        function exportarRelatorioAutomatizado(formato) {
            if(!dadosFiltrados.length) {
                showError('Nenhum apontamento para exportar.');
                return;
            }

            const dados = dadosFiltrados.map(apt => {
                const codigo = extrairCodigoVaga(apt.Vaga);
                const indexOriginal = dadosCSV.indexOf(apt);
                const isIrregular = apontamentosIrregulares.some(irr => irr.index === indexOriginal);

                // Determinar regime automaticamente
                let regime = 'ADM';
                Object.keys(REGIMES_CONFIG).forEach(key => {
                    REGIMES_CONFIG[key].identificadores.forEach(id => {
                        if(apt.Vaga && apt.Vaga.toUpperCase().includes(id)) {
                            regime = REGIMES_CONFIG[key].nome;
                        }
                    });
                });

                return {
                    'Equipamento': codigo || '',
                    'Regime': regime,
                    'Supervisor': '', // Campo manual
                    'Data De Apontamento': apt['Data Inicial']?.split(' ')[0] || '',
                    'Motorista': '', // Campo manual
                    'Gravidade': isIrregular ? 'Irregular' : 'Normal',
                    'Apontamento': apt['Categoria Demora'] || '',
                    'Problemas Identificados': isIrregular ? 'Detectado automaticamente' : '',
                    'Hora': extrairIntervaloTempo(apt['Data Inicial'], apt['Data Final']) || '',
                    'Justificativa': '', // Campo manual
                    'Tratativa': '', // Campo manual
                    'Sugestão': '' // Campo manual
                };
            });

            const nome = `Relatorio_Automatizado_${new Date().toLocaleDateString('pt-BR').replace(/\//g, '_')}`;
            
            if(formato === 'xlsx') {
                exportarParaXLSX(dados, nome);
            } else {
                exportarParaCSV(dados, nome);
            }

            showSuccess(`Relatório automatizado exportado! ${dados.length} registros processados.`);
        }

        function exportarIrregularesApenas() {
            if(!apontamentosIrregulares.length) {
                showError('Nenhum apontamento irregular para exportar.');
                return;
            }

            const dados = apontamentosIrregulares.map(problema => ({
                'Equipamento': problema.equipamento || '',
                'Regime': regimeAtivo ? regimesDisponiveis[regimeAtivo].nome : '',
                'Supervisor': '',
                'Data De Apontamento': problema.intervalo?.split(' ')[0] || '',
                'Motorista': '',
                'Gravidade': problema.gravidade || 'MÉDIA',
                'Apontamento': problema.categoria || '',
                'Problemas Identificados': problema.tipo || '',
                'Hora': problema.intervalo || problema.tempo || '',
                'Justificativa': '',
                'Tratativa': '',
                'Sugestão': ''
            }));

            const nome = `Irregulares_${new Date().toLocaleDateString('pt-BR').replace(/\//g, '_')}`;
            exportarParaXLSX(dados, nome);
            showSuccess(`Relatório de irregulares exportado! ${dados.length} registros.`);
        }

        function exportarPorRegime() {
            if(!regimeAtivo) {
                showError('Nenhum regime ativo para exportar.');
                return;
            }

            const config = regimesDisponiveis[regimeAtivo];
            const dadosRegime = dadosFiltrados.filter(apt => {
                const codigo = extrairCodigoVaga(apt.Vaga);
                return config.equipamentos.includes(codigo);
            });

            const dados = dadosRegime.map(apt => {
                const codigo = extrairCodigoVaga(apt.Vaga);
                const indexOriginal = dadosCSV.indexOf(apt);
                const isIrregular = apontamentosIrregulares.some(irr => irr.index === indexOriginal);

                return {
                    'Equipamento': codigo || '',
                    'Regime': config.nome,
                    'Supervisor': '',
                    'Data De Apontamento': apt['Data Inicial']?.split(' ')[0] || '',
                    'Motorista': '',
                    'Gravidade': isIrregular ? 'Irregular' : 'Normal',
                    'Apontamento': apt['Categoria Demora'] || '',
                    'Problemas Identificados': isIrregular ? 'Detectado automaticamente' : '',
                    'Hora': extrairIntervaloTempo(apt['Data Inicial'], apt['Data Final']) || '',
                    'Justificativa': '',
                    'Tratativa': '',
                    'Sugestão': ''
                };
            });

            const nome = `Regime_${config.nome.replace(/\s+/g, '_')}_${new Date().toLocaleDateString('pt-BR').replace(/\//g, '_')}`;
            exportarParaXLSX(dados, nome);
            showSuccess(`Relatório do regime ${config.nome} exportado! ${dados.length} registros.`);
        }

        function exportarParaXLSX(dados, nome) {
            const ws = XLSX.utils.json_to_sheet(dados);
            
            // Configurar larguras das colunas
            ws['!cols'] = [
                {width: 20}, // Equipamento
                {width: 15}, // Regime
                {width: 25}, // Supervisor
                {width: 20}, // Data De Apontamento
                {width: 25}, // Motorista
                {width: 12}, // Gravidade
                {width: 20}, // Apontamento
                {width: 25}, // Problemas Identificados
                {width: 20}, // Hora
                {width: 30}, // Justificativa
                {width: 30}, // Tratativa
                {width: 30}  // Sugestão
            ];

            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Relatório');
            XLSX.writeFile(wb, `${nome}.xlsx`);
        }

        function exportarParaCSV(dados, nome) {
            const csv = Papa.unparse(dados, {delimiter: ';', header: true});
            const blob = new Blob(["\uFEFF" + csv], {type: 'text/csv;charset=utf-8;'});
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `${nome}.csv`;
            link.click();
            URL.revokeObjectURL(link.href);
        }

        // Sistema de Timeline Inteligente
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.add('hidden'));

            const button = document.querySelector(`[onclick="switchTab('${tabName}')"]`);
            const tab = document.getElementById(tabName + '-tab');

            button.classList.add('active');
            tab.classList.remove('hidden');

            if(tabName === 'timeline') {
                if(Object.keys(equipamentosProcessados).length) {
                    gerarTimelineInteligente();
                } else if(dadosCSV.length) {
                    document.getElementById('timelineContainer').innerHTML = '<div class="timeline-empty">Processe os dados carregados para visualizar a timeline inteligente.</div>';
                }
            }
        }

        function gerarTimelineInteligente() {
            const container = document.getElementById('timelineContainer');
            if(!container) return;

            const equipamentos = Object.values(equipamentosProcessados);
            if(!equipamentos.length) {
                container.innerHTML = '<div class="timeline-empty">Nenhum equipamento encontrado para exibir na timeline.</div>';
                atualizarSeletorEquipamentosTimeline([]);
                return;
            }

            atualizarSeletorEquipamentosTimeline(equipamentos);
            equipamentos.sort((a, b) => a.codigo.localeCompare(b.codigo));

            container.innerHTML = equipamentos.map(equipamento => {
                const apontamentosOrdenados = [...equipamento.apontamentos].sort((a, b) => 
                    (a.dataHoraInicio || 0) - (b.dataHoraInicio || 0)
                );

                return `
                    <div class="timeline-equipment-container" data-equipment-code="${equipamento.codigo}" data-equipment-type="${equipamento.tipo}">
                        <div class="timeline-equipment-header">
                            <span class="timeline-equipment-code">${equipamento.codigo}</span>
                            <span class="timeline-equipment-details">
                                (${equipamento.tipo === 'AP' ? 'Alta Pressão' : 
                                   equipamento.tipo === 'AV' ? 'Auto Vácuo' : 'Hiper Vácuo'} | 
                                ${equipamento.totalApontamentos} apontamentos | 
                                Status: ${equipamento.status})
                            </span>
                        </div>
                        <div class="timeline-horizontal-wrapper">
                            ${gerarReguaInteligente()}
                            ${gerarMarcadoresTempo()}
                            <div class="timeline-horizontal-track" data-zoom="${zoomLevel}" style="--w:${100 * zoomLevel}%">
                                ${apontamentosOrdenados.map(apt => gerarBlocoApontamentoInteligente(apt)).join('')}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            filtrarTimeline();
        }

        function gerarReguaInteligente() {
            const horas = [];
            for(let h = 0; h <= 24; h += 3) {
                horas.push(h === 24 ? 0 : h);
            }

            return `
                <div class="timeline-ruler" data-zoom="${zoomLevel}" style="--w:${100 * zoomLevel}%">
                    ${horas.map(hora => `
                        <span style="left:${(hora === 0 && horas.indexOf(hora) > 0 ? 24 : hora) / 24 * 100}%">
                            ${String(hora).padStart(2, '0')}:00
                        </span>
                    `).join('')}
                </div>
            `;
        }

        function gerarMarcadoresTempo() {
            const marcadores = [];
            for(let h = 0; h < 24; h++) {
                const isMajor = h % 6 === 0;
                marcadores.push(`
                    <div class="timeline-marker ${isMajor ? 'major' : ''}" 
                         style="left:${h / 24 * 100}%">
                        ${isMajor ? `<div class="timeline-marker-label">${String(h).padStart(2, '0')}h</div>` : ''}
                    </div>
                `);
            }

            return `<div class="timeline-markers">${marcadores.join('')}</div>`;
        }

        function gerarBlocoApontamentoInteligente(apontamento) {
            if(!apontamento.inicioHHMM || !apontamento.tempoIndisponivel) return '';

            const inicioMinutos = horaParaMinutos(apontamento.inicioHHMM);
            const duracaoMinutos = tempoParaMinutos(apontamento.tempoIndisponivel);

            if(!duracaoMinutos) return '';

            const left = (inicioMinutos / 1440) * 100;
            const width = Math.max((duracaoMinutos / 1440) * 100, 0.3);
            const cor = getCorCategoria(apontamento.categoria);

            const tooltip = `
                Categoria: ${apontamento.categoria}
                Início: ${apontamento.inicioHHMM}
                Duração: ${apontamento.tempoIndisponivel}
                Intervalo: ${apontamento.intervalo}
                ${apontamento.irregular ? 'Status: IRREGULAR' : 'Status: NORMAL'}
            `.trim();

            // Lógica melhorada para exibição de texto nos blocos
            let textoBloco = '';
            if(apontamento.irregular) {
                textoBloco = 'IRR';
            } else {
                // Criar siglas inteligentes para categorias
                const categoria = apontamento.categoria.toUpperCase();
                if(categoria.includes('REFEIÇÃO')) textoBloco = 'REF';
                else if(categoria.includes('ABASTECIMENTO')) textoBloco = 'ABAST';
                else if(categoria.includes('MANUTENÇÃO CORRETIVA')) textoBloco = 'MAN-C';
                else if(categoria.includes('MANUTENÇÃO PREVENTIVA')) textoBloco = 'MAN-P';
                else if(categoria.includes('DESLOCAMENTO')) textoBloco = 'DESL';
                else if(categoria.includes('CHECKLIST')) textoBloco = 'CHECK';
                else if(categoria.includes('ESPERA')) textoBloco = 'ESP';
                else if(categoria.includes('LIMPEZA')) textoBloco = 'LIMP';
                else {
                    // Para outras categorias, usar as primeiras letras
                    const palavras = categoria.split(' ');
                    if(palavras.length > 1) {
                        textoBloco = palavras.map(p => p.charAt(0)).join('').substring(0, 4);
                    } else {
                        textoBloco = categoria.substring(0, 4);
                    }
                }
            }

            return `
                <div class="timeline-block ${apontamento.irregular ? 'irregular' : ''}" 
                     style="left:${left.toFixed(2)}%; width:${width.toFixed(2)}%; background:${cor}; 
                            font-size:${width > 2 ? '0.7rem' : '0.6rem'}; font-weight:bold;" 
                     title="${tooltip}"
                     data-category="${apontamento.categoria.toLowerCase()}"
                     data-date="${apontamento.dataInicialOriginal ? apontamento.dataInicialOriginal.split(' ')[0] : ''}"
                     data-status="${apontamento.irregular ? 'irregular' : 'normal'}"
                     onmouseover="mostrarTooltipInteligente(event, this)"
                     onmouseout="ocultarTooltipInteligente()">
                    ${textoBloco}
                </div>
            `;
        }

        let tooltipAtual = null;

        function mostrarTooltipInteligente(event, elemento) {
            ocultarTooltipInteligente();

            const tooltip = document.createElement('div');
            tooltip.className = 'timeline-tooltip show';
            tooltip.innerHTML = elemento.title.replace(/\n/g, '<br>');

            document.body.appendChild(tooltip);
            tooltipAtual = tooltip;

            const rect = elemento.getBoundingClientRect();
            tooltip.style.left = (rect.left + rect.width / 2) + 'px';
            tooltip.style.top = (rect.top - tooltip.offsetHeight - 10) + 'px';
        }

        function ocultarTooltipInteligente() {
            if(tooltipAtual) {
                tooltipAtual.remove();
                tooltipAtual = null;
            }
        }

        function updateZoom(valor) {
            zoomLevel = parseFloat(valor);
            document.getElementById('zoomLabel').textContent = zoomLevel.toFixed(1) + 'x';

            document.querySelectorAll('.timeline-horizontal-track').forEach(track => {
                track.dataset.zoom = zoomLevel;
                track.style.setProperty('--w', (100 * zoomLevel) + '%');
            });

            document.querySelectorAll('.timeline-ruler').forEach(ruler => {
                ruler.dataset.zoom = zoomLevel;
                ruler.style.setProperty('--w', (100 * zoomLevel) + '%');
            });
        }

        function ajustarZoom(delta) {
            const novoZoom = Math.min(10, Math.max(1, zoomLevel + (delta * 0.5)));
            document.getElementById('timelineZoom').value = novoZoom;
            updateZoom(novoZoom);
        }

        function resetarZoom() {
            document.getElementById('timelineZoom').value = 1;
            updateZoom(1);
        }

        function atualizarLegendaTimeline() {
            const legenda = document.getElementById('timelineLegend');
            if(!legenda) return;

            const categorias = new Set();
            Object.values(equipamentosProcessados).forEach(eq => 
                eq.apontamentos.forEach(apt => categorias.add(apt.categoria.toUpperCase()))
            );

            let html = '';
            categorias.forEach(categoria => {
                const cor = getCorCategoria(categoria);
                
                // Determinar sigla para a categoria
                let sigla = '';
                if(categoria.includes('REFEIÇÃO')) sigla = ' (REF)';
                else if(categoria.includes('ABASTECIMENTO')) sigla = ' (ABAST)';
                else if(categoria.includes('MANUTENÇÃO CORRETIVA')) sigla = ' (MAN-C)';
                else if(categoria.includes('MANUTENÇÃO PREVENTIVA')) sigla = ' (MAN-P)';
                else if(categoria.includes('DESLOCAMENTO')) sigla = ' (DESL)';
                else if(categoria.includes('CHECKLIST')) sigla = ' (CHECK)';
                else if(categoria.includes('ESPERA')) sigla = ' (ESP)';
                else if(categoria.includes('LIMPEZA')) sigla = ' (LIMP)';
                else {
                    const palavras = categoria.split(' ');
                    if(palavras.length > 1) {
                        sigla = ' (' + palavras.map(p => p.charAt(0)).join('').substring(0, 4) + ')';
                    } else {
                        sigla = ' (' + categoria.substring(0, 4) + ')';
                    }
                }

                html += `
                    <div class="legend-item">
                        <span class="legend-color-box" style="background:${cor}"></span>
                        ${categoria.charAt(0) + categoria.slice(1).toLowerCase()}${sigla}
                    </div>
                `;
            });

            if(apontamentosIrregulares.length) {
                html += `
                    <div class="legend-item">
                        <span class="legend-color-box" style="border:2px dashed #c0392b;background:transparent"></span>
                        Irregular (IRR)
                    </div>
                `;
            }

            legenda.innerHTML = html || '<div class="legend-item">Sem dados para legenda.</div>';
        }

        function atualizarSeletorEquipamentosTimeline(equipamentos) {
            const selector = document.getElementById('equipmentSelectorTimeline');
            if(!selector) return;

            const selecionados = Array.from(selector.selectedOptions).map(opt => opt.value);
            selector.innerHTML = '';

            equipamentos.forEach(eq => {
                const option = document.createElement('option');
                option.value = eq.codigo;
                option.textContent = `${eq.codigo} (${eq.totalApontamentos} apts)`;
                if(selecionados.includes(eq.codigo)) option.selected = true;
                selector.appendChild(option);
            });
        }

        function filtrarTimeline() {
            const pesquisa = (document.getElementById('timelineSearch').value || '').toLowerCase();
            const data = document.getElementById('timelineDate').value;
            const tipo = document.getElementById('timelineTypeFilter').value;
            const status = document.getElementById('timelineStatusFilter').value;
            const selecionados = Array.from(document.getElementById('equipmentSelectorTimeline').selectedOptions).map(opt => opt.value);

            document.querySelectorAll('.timeline-equipment-container').forEach(div => {
                const codigo = div.dataset.equipmentCode;
                const tipoEquip = div.dataset.equipmentType;
                let mostrar = true;

                if(selecionados.length && !selecionados.includes(codigo)) mostrar = false;
                if(mostrar && pesquisa && !codigo.toLowerCase().includes(pesquisa)) mostrar = false;
                if(mostrar && tipo && tipoEquip !== tipo) mostrar = false;

                if(mostrar) {
                    let temBlocoVisivel = false;
                    div.querySelectorAll('.timeline-block').forEach(bloco => {
                        let mostrarBloco = true;

                        if(data) {
                            const [dia, mes, ano] = bloco.dataset.date.split('/');
                            if(`${ano}-${mes}-${dia}` !== data) mostrarBloco = false;
                        }

                        if(mostrarBloco && status && bloco.dataset.status !== status) mostrarBloco = false;

                        bloco.style.display = mostrarBloco ? 'flex' : 'none';
                        if(mostrarBloco) temBlocoVisivel = true;
                    });

                    if((data || status) && !temBlocoVisivel) mostrar = false;
                }

                div.style.display = mostrar ? 'block' : 'none';
            });
        }

        function clearTimelineSelection() {
            const selector = document.getElementById('equipmentSelectorTimeline');
            Array.from(selector.options).forEach(opt => opt.selected = false);
            filtrarTimeline();
        }

        async function exportarTimelinePDF(tipo) {
            showSuccess('Iniciando geração de PDF da timeline...');

            const container = document.getElementById('timelineContainer');
            if(!container || !container.children.length) {
                showError('Nenhum conteúdo na timeline para exportar.');
                return;
            }

            let html = `
                <div class="pdf-header">
                    <div class="pdf-title">Timeline Inteligente de Equipamentos - GrupoGPS</div>
                    <div class="pdf-subtitle">Relatório de Apontamentos Cronológicos</div>
                    <div class="pdf-date">Gerado: ${new Date().toLocaleString('pt-BR')}</div>
                </div>
            `;

            const divs = [];
            if(tipo === 'selected') {
                const selecionados = Array.from(document.getElementById('equipmentSelectorTimeline').selectedOptions).map(opt => opt.value);
                if(!selecionados.length) {
                    showError('Nenhum equipamento selecionado.');
                    return;
                }

                selecionados.forEach(codigo => {
                    const div = document.querySelector(`.timeline-equipment-container[data-equipment-code="${codigo}"]`);
                    if(div) divs.push(div.cloneNode(true));
                });
            } else {
                document.querySelectorAll('.timeline-equipment-container').forEach(div => {
                    if(div.style.display !== 'none') divs.push(div.cloneNode(true));
                });
            }

            if(!divs.length) {
                showError('Nenhum equipamento visível para exportar.');
                return;
            }

            const temp = document.createElement('div');
            temp.className = 'pdf-timeline-container';
            temp.style.position = 'absolute';
            temp.style.left = '-10000px';
            temp.style.width = `${1200 * zoomLevel}px`;
            temp.innerHTML = html;

            divs.forEach(div => {
                const track = div.querySelector('.timeline-horizontal-track');
                const ruler = div.querySelector('.timeline-ruler');
                if(track) track.style.width = '100%';
                if(ruler) ruler.style.width = '100%';
                temp.appendChild(div);
            });

            document.body.appendChild(temp);

            try {
                const canvas = await html2canvas(temp, {
                    scale: 1.5,
                    useCORS: true,
                    windowWidth: temp.scrollWidth,
                    windowHeight: temp.scrollHeight
                });

                const imgData = canvas.toDataURL('image/png');
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('l', 'mm', 'a4');

                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();
                const imgProps = pdf.getImageProperties(imgData);
                const imgHeight = (imgProps.height * pageWidth) / imgProps.width;

                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', 0, position, pageWidth, imgHeight);
                heightLeft -= pageHeight;

                while(heightLeft > 0) {
                    pdf.addPage();
                    position -= pageHeight;
                    pdf.addImage(imgData, 'PNG', 0, position, pageWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save(`Timeline_Inteligente_${new Date().toLocaleDateString('pt-BR').replace(/\//g, '_')}.pdf`);
                showSuccess('PDF da timeline gerado com sucesso!');

            } catch(error) {
                console.error(error);
                showError('Erro ao gerar PDF: ' + error.message);
            } finally {
                document.body.removeChild(temp);
            }
        }

        function showError(mensagem) {
            document.querySelectorAll('.error, .success').forEach(el => el.remove());
            const div = document.createElement('div');
            div.className = 'error';
            div.textContent = mensagem;
            const container = document.querySelector('.container') || document.body;
            container.insertBefore(div, container.firstChild);
            setTimeout(() => div.remove(), 6000);
        }

        function showSuccess(mensagem) {
            document.querySelectorAll('.error, .success').forEach(el => el.remove());
            const div = document.createElement('div');
            div.className = 'success';
            div.textContent = mensagem;
            const container = document.querySelector('.container') || document.body;
            container.insertBefore(div, container.firstChild);
            setTimeout(() => div.remove(), 4000);
        }
    </script>
