<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Monitoramento GrupoGPS</title>

    <!-- libs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.3.2/papaparse.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- styles -->
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:#f5f7fa;min-height:100vh;color:#333}
        .header{background:#2c3e50;color:#fff;padding:20px;text-align:center;box-shadow:0 2px 10px rgba(0,0,0,.1)}
        .header h1{font-size:1.8rem;margin-bottom:5px}
        .header p{opacity:.9;font-size:.9rem}
        .container{max-width:1400px;margin:20px auto;padding:0 20px}
        .upload-section,.export-section,.filters-section,.stats-section,.problems-section,.equipamentos-section,.timeline-section,.regime-section{background:#fff;border-radius:10px;padding:25px;margin-bottom:20px;box-shadow:0 2px 10px rgba(0,0,0,.05)}
        .upload-area{border:3px dashed #3498db;border-radius:10px;padding:40px 20px;margin:20px 0;transition:.3s ease;cursor:pointer;background:#f8f9fa;text-align:center}
        .upload-area:hover,.upload-area.dragover{border-color:#2980b9;background:#e3f2fd}
        .upload-text{font-size:1.1rem;color:#2c3e50;margin-bottom:5px;font-weight:600}
        .upload-subtext{color:#7f8c8d;font-size:.9rem}
        #fileInput{display:none}
        .btn{background:#3498db;color:#fff;padding:10px 20px;border:none;border-radius:8px;cursor:pointer;font-size:.95rem;font-weight:600;transition:.3s ease;margin:5px}
        .btn:hover{background:#2980b9;transform:translateY(-2px)}
        .btn:disabled{background:#bdc3c7;cursor:not-allowed;transform:none}
        .btn-success{background:#27ae60}.btn-success:hover{background:#219a52}
        .btn-warning{background:#f39c12}.btn-warning:hover{background:#e67e22}
        .btn-danger{background:#e74c3c}.btn-danger:hover{background:#c0392b}
        .section-title{text-align:center;font-size:1.5rem;color:#2c3e50;margin-bottom:20px;padding-bottom:10px;border-bottom:2px solid #3498db}
        .export-buttons,.filters-grid{display:flex;gap:15px;flex-wrap:wrap;align-items:flex-end}
        .filters-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
        .filter-group{display:flex;flex-direction:column;flex-grow:1}
        .filter-label{font-weight:600;color:#2c3e50;margin-bottom:8px;font-size:.9rem}
        .filter-input{padding:10px;border:1px solid #ced4da;border-radius:6px;font-size:.9rem;transition:border-color .3s ease,box-shadow .3s ease}
        .filter-input:focus{outline:none;border-color:#3498db;box-shadow:0 0 0 .2rem rgba(52,152,219,.25)}
        .stats-section{display:none}
        .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:15px}
        .stat-card{padding:20px;border-radius:10px;text-align:center;box-shadow:0 1px 3px rgba(0,0,0,.05);border-left:4px solid #3498db}
        .stat-number{font-size:2rem;font-weight:bold;margin-bottom:5px;color:#2c3e50}
        .stat-label{color:#7f8c8d;font-size:.9rem;font-weight:600}
        .problems-section{display:none}
        .problems-title{font-size:1.3rem;color:#e74c3c;margin-bottom:15px;font-weight:700}
        .problem-item{background:#fff5f5;border-left:4px solid #e74c3c;padding:12px;margin-bottom:10px;border-radius:6px}
        .problem-type{font-weight:600;color:#c0392b;margin-bottom:5px}
        .problem-details{font-size:.9rem;color:#7f8c8d}
        .equipamentos-section{display:none}
        .equipamentos-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:20px}
        .equipamento-card{border-radius:10px;padding:20px;box-shadow:0 1px 3px rgba(0,0,0,.05);border-left:4px solid #3498db;transition:.3s ease}
        .equipamento-card:hover{transform:translateY(-2px);box-shadow:0 4px 15px rgba(0,0,0,.1)}
        .equipamento-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
        .equipamento-codigo{font-size:1.3rem;font-weight:bold;color:#2c3e50}
        .equipamento-tipo{font-size:.8rem;color:#7f8c8d;background:#f0f3f5;padding:4px 8px;border-radius:12px;font-weight:600}
        .equipamento-status{padding:5px 10px;border-radius:15px;font-size:.75rem;font-weight:700;text-transform:uppercase}
        .status-bom{background:#d4edda;color:#155724;border-left-color:#27ae60!important}
        .status-atencao{background:#fff3cd;color:#856404;border-left-color:#f39c12!important}
        .status-critico{background:#f8d7da;color:#721c24;border-left-color:#e74c3c!important}
        .equipamento-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:15px;font-size:.9rem}
        .stat-item{text-align:center;padding:10px;background:#f8f9fa;border-radius:6px}
        .stat-item-number{font-size:1.2rem;font-weight:bold;color:#2c3e50}
        .stat-item-label{font-size:.8rem;color:#7f8c8d;margin-top:3px}
        .apontamentos-lista{max-height:180px;overflow-y:auto;border:1px solid #e9ecef;border-radius:6px;padding:10px;background:#fafbfc}
        .apontamento-item{background:#fff;border-radius:6px;padding:8px 10px;margin-bottom:6px;border-left:3px solid #3498db;font-size:.85rem}
        .apontamento-item:last-child{margin-bottom:0}
        .apontamento-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
        .apontamento-categoria{font-weight:600;color:#2c3e50}
        .apontamento-tempo{background:#3498db;color:#fff;padding:2px 6px;border-radius:10px;font-size:.75rem;font-weight:600}
        .apontamento-detalhes{font-size:.8rem;color:#7f8c8d}
        .apontamento-intervalo{font-weight:600;color:#2c3e50;font-size:.85rem}
        .apontamento-irregular{border-left-color:#e74c3c!important;background:#fff5f5!important}
        .apontamento-irregular .apontamento-tempo{background:#e74c3c}
        .loading{text-align:center;padding:40px;color:#7f8c8d;font-size:1.1rem}
        .error,.success{padding:15px;border-radius:8px;margin:0 0 20px;text-align:center;font-weight:500}
        .error{background:#e74c3c;color:#fff}
        .success{background:#27ae60;color:#fff}
        .hidden{display:none!important}
        .tabs-container{background:#fff;border-radius:10px 10px 0 0;padding:0;margin-bottom:0;box-shadow:0 2px 10px rgba(0,0,0,.05);overflow:hidden}
        .tabs-header{display:flex;background:#f8f9fa;border-bottom:1px solid #e0e0e0}
        .tab-btn{flex:1;padding:15px 20px;background:transparent;border:none;cursor:pointer;font-size:1rem;font-weight:600;color:#7f8c8d;transition:.3s ease;position:relative;border-bottom:3px solid transparent}
        .tab-btn:hover{color:#2980b9}
        .tab-btn.active{color:#2c3e50;border-bottom-color:#3498db}
        .tab-content{display:block;padding:0}
        .tab-content.hidden{display:none}
        .timeline-section{padding-top:25px}
        .timeline-filters-container{padding:20px;background:#f8f9fa;border-radius:8px;margin-bottom:25px;border:1px solid #e9ecef}
        .timeline-filters-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;align-items:flex-end}
        #equipmentSelectorTimeline{height:120px}
        .timeline-legend{display:flex;flex-wrap:wrap;gap:10px 20px;padding:15px;background:#f0f3f5;border-radius:8px;margin-bottom:25px;justify-content:center}
        .legend-item{display:flex;align-items:center;gap:8px;font-size:.85rem}
        .legend-color-box{width:15px;height:15px;border-radius:3px;border:1px solid rgba(0,0,0,.1)}
        .timeline-equipment-container{background:#fff;border-radius:8px;padding:20px;margin-bottom:25px;box-shadow:0 2px 8px rgba(0,0,0,.08);border:1px solid #e9ecef}
        .timeline-equipment-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px;padding-bottom:10px;border-bottom:1px solid #e0e0e0}
        .timeline-equipment-code{font-size:1.2rem;font-weight:700;color:#2c3e50}
        .timeline-equipment-details{font-size:.9rem;color:#555}
        .timeline-horizontal-wrapper{width:100%;overflow-x:auto;padding-bottom:10px}
        .timeline-ruler{display:flex;justify-content:space-between;font-size:.75rem;color:#7f8c8d;padding:0 5px;margin-bottom:5px;height:20px;border-bottom:1px dashed #ccc}
        .timeline-ruler span{display:inline-block;transform:translateX(-50%)}
        .timeline-ruler span:first-child{transform:translateX(0)}
        .timeline-ruler span:last-child{transform:translateX(-100%)}
        .timeline-horizontal-track{position:relative;width:100%;height:40px;background:#e9ecef;border-radius:5px;margin-top:5px}
        .timeline-block{position:absolute;height:100%;border-radius:4px;cursor:pointer;transition:transform .2s ease,box-shadow .2s ease;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:0 3px;border:1px solid rgba(0,0,0,.2);font-weight:bold;text-shadow:1px 1px 2px rgba(0,0,0,.5)}
        .timeline-block:hover{transform:scaleY(1.1);z-index:10;box-shadow:0 2px 5px rgba(0,0,0,.2)}
        .timeline-block.irregular{border:2px dashed #c0392b}
        .timeline-empty{text-align:center;padding:40px;color:#7f8c8d;font-style:italic;font-size:1rem}
        .pdf-timeline-container{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:#fff;padding:30px;max-width:none;box-shadow:none}
        .pdf-header{text-align:center;margin-bottom:30px;border-bottom:3px solid #3498db;padding-bottom:20px}
        .pdf-title{font-size:28px;font-weight:bold;color:#2c3e50;margin-bottom:10px}
        .pdf-subtitle{font-size:16px;color:#7f8c8d;margin-bottom:5px}
        .pdf-date{font-size:14px;color:#95a5a6}

        /* Sistema de Regimes e Turnos */
        .regime-section{background:#f8f9fa;border:2px solid #3498db}
        .regime-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:20px}
        .regime-card{background:#fff;border-radius:8px;padding:20px;border-left:4px solid #3498db;box-shadow:0 2px 8px rgba(0,0,0,.1)}
        .regime-card.active{border-left-color:#27ae60;background:#f0fff4}
        .regime-title{font-size:1.2rem;font-weight:bold;color:#2c3e50;margin-bottom:10px}
        .regime-turnos{font-size:.9rem;color:#7f8c8d;margin-bottom:15px}
        .regime-btn{width:100%;padding:10px;background:#3498db;color:#fff;border:none;border-radius:6px;cursor:pointer;font-weight:600;transition:.3s ease}
        .regime-btn:hover{background:#2980b9}
        .regime-btn.active{background:#27ae60}
        .regime-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:15px;font-size:.8rem}
        .regime-stat{text-align:center;padding:8px;background:#f8f9fa;border-radius:4px}

        /* Zoom melhorado */
        .timeline-horizontal-track[data-zoom],
        .timeline-ruler[data-zoom]{width:var(--w,100%)}
        .zoom-controls{display:flex;align-items:center;gap:15px;padding:15px;background:#fff;border-radius:8px;border:1px solid #e0e0e0;margin-bottom:20px}
        .zoom-btn{padding:8px 12px;background:#3498db;color:#fff;border:none;border-radius:4px;cursor:pointer;font-size:.9rem;transition:.3s ease}
        .zoom-btn:hover{background:#2980b9}
        .zoom-slider{flex:1;margin:0 10px}
        .zoom-label{font-weight:600;color:#2c3e50;min-width:60px;text-align:center}

        /* Tooltips melhorados */
        .timeline-tooltip{position:absolute;background:#2c3e50;color:#fff;padding:8px 12px;border-radius:6px;font-size:.8rem;z-index:1000;white-space:nowrap;pointer-events:none;transform:translateX(-50%);opacity:0;transition:opacity .3s ease}
        .timeline-tooltip.show{opacity:1}
        .timeline-tooltip::after{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);border:5px solid transparent;border-top-color:#2c3e50}

        /* Marcadores de tempo melhorados */
        .timeline-markers{position:relative;height:30px;margin-bottom:10px}
        .timeline-marker{position:absolute;width:2px;height:20px;background:#bdc3c7;top:5px}
        .timeline-marker.major{background:#7f8c8d;height:25px;top:0}
        .timeline-marker-label{position:absolute;top:25px;transform:translateX(-50%);font-size:.7rem;color:#7f8c8d;font-weight:500}

        /* Footer */
        .footer{background:#2c3e50;color:#fff;text-align:center;padding:15px;margin-top:40px;font-size:.9rem}

        @media(max-width:768px){
            .container{padding:0 10px}
            .equipamentos-grid,.stats-grid,.filters-grid,.timeline-filters-grid,.regime-grid{grid-template-columns:1fr}
            .export-buttons{flex-direction:column;align-items:stretch}
            .export-buttons .btn{width:100%}
            .tabs-header{flex-direction:column}
            .tab-btn{border-bottom-width:2px}
            .timeline-equipment-header{flex-direction:column;align-items:flex-start;gap:8px}
            .zoom-controls{flex-direction:column;gap:10px}
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Sistema Monitoramento GrupoGPS</h1>
        <p>Dashboard de Acompanhamento de Equipamentos - Versão Inteligente</p>
    </div>

    <div class="container">
        <div class="tabs-container">
            <div class="tabs-header">
                <button class="tab-btn active" onclick="switchTab('dashboard')">Dashboard</button>
                <button class="tab-btn" onclick="switchTab('regimes')">Regimes & Turnos</button>
                <button class="tab-btn" onclick="switchTab('timeline')">Timeline Inteligente</button>
            </div>
        </div>

        <!-- ABA DASHBOARD -->
        <div class="tab-content" id="dashboard-tab">
            <section class="upload-section">
                <div class="upload-area" id="uploadArea">
                    <div class="upload-text">Clique aqui ou arraste o arquivo CSV</div>
                    <div class="upload-subtext">Arquivo: Demoras Categorizadas (CSV)</div>
                </div>
                <input type="file" id="fileInput" accept=".csv" />
                <button class="btn" onclick="document.getElementById('fileInput').click()">Selecionar Arquivo</button>
                <button class="btn" id="processBtn" onclick="processarArquivo()" disabled>Processar Dados</button>
            </section>

            <section class="export-section" id="exportSection" style="display:none">
                <h2 class="section-title">Exportar Relatórios Automatizados</h2>
                <div class="export-buttons">
                    <button class="btn btn-success" onclick="exportarRelatorioAutomatizado('xlsx')">Relatório Completo (XLSX)</button>
                    <button class="btn btn-warning" onclick="exportarRelatorioAutomatizado('csv')">Relatório Completo (CSV)</button>
                    <button class="btn btn-danger" onclick="exportarIrregularesApenas()">Apenas Irregulares (XLSX)</button>
                </div>
            </section>

            <section class="filters-section" id="filtersSection" style="display:none">
                <h2 class="section-title">Filtrar Dados do Dashboard</h2>
                <div class="filters-grid">
                    <div class="filter-group">
                        <label class="filter-label" for="dataInicial">Data Inicial</label>
                        <input type="date" class="filter-input" id="dataInicial">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label" for="dataFinal">Data Final</label>
                        <input type="date" class="filter-input" id="dataFinal">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label" for="horaInicial">Hora Inicial</label>
                        <input type="time" class="filter-input" id="horaInicial">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label" for="horaFinal">Hora Final</label>
                        <input type="time" class="filter-input" id="horaFinal">
                    </div>
                    <div class="filter-group">
                        <label class="filter-label" for="tipoFilter">Tipo Equipamento</label>
                        <select class="filter-input" id="tipoFilter">
                            <option value="">Todos</option>
                            <option value="AP">Alta Pressão</option>
                            <option value="AV">Auto Vácuo</option>
                            <option value="HP">Hiper Vácuo</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <button class="btn" onclick="aplicarFiltros()" style="width:100%">Filtrar Dashboard</button>
                    </div>
                </div>
            </section>

            <section class="stats-section" id="statsSection">
                <h2 class="section-title">Estatísticas Gerais</h2>
                <div class="stats-grid" id="statsGrid"></div>
            </section>

            <section class="problems-section" id="problemsSection">
                <h2 class="section-title" style="color:#e74c3c;border-color:#e74c3c">Apontamentos Irregulares</h2>
                <div id="problemsList"></div>
            </section>

            <section class="equipamentos-section" id="equipamentosSection">
                <h2 class="section-title">Detalhes por Equipamento</h2>
                <div class="equipamentos-grid" id="equipamentosGrid"></div>
            </section>
        </div>

        <!-- ABA REGIMES & TURNOS -->
        <div class="tab-content hidden" id="regimes-tab">
            <section class="regime-section">
                <h2 class="section-title">Sistema Inteligente de Regimes e Turnos</h2>
                <div id="regimeContainer">
                    <div class="timeline-empty">Carregue e processe um arquivo CSV para visualizar os regimes disponíveis.</div>
                </div>
            </section>
        </div>

        <!-- ABA TIMELINE -->
        <div class="tab-content hidden" id="timeline-tab">
            <section class="timeline-section">
                <h2 class="section-title">Timeline Inteligente de Equipamentos</h2>

                <div class="zoom-controls">
                    <button class="zoom-btn" onclick="ajustarZoom(-1)">-</button>
                    <input type="range" id="timelineZoom" class="zoom-slider" min="1" max="10" value="1" step="0.5" oninput="updateZoom(this.value)">
                    <button class="zoom-btn" onclick="ajustarZoom(1)">+</button>
                    <div class="zoom-label" id="zoomLabel">1.0x</div>
                    <button class="btn" onclick="resetarZoom()">Reset</button>
                </div>

                <div class="timeline-filters-container">
                    <h3 style="font-size:1.1rem;color:#2c3e50;margin-bottom:15px;text-align:center">Filtros Avançados da Timeline</h3>
                    <div class="timeline-filters-grid">
                        <div class="filter-group">
                            <label class="filter-label" for="timelineSearch">Pesquisar Equipamento:</label>
                            <input type="text" id="timelineSearch" class="filter-input" placeholder="Ex: AV-01">
                        </div>
                        <div class="filter-group">
                            <label class="filter-label" for="timelineDate">Data:</label>
                            <input type="date" id="timelineDate" class="filter-input">
                        </div>
                        <div class="filter-group">
                            <label class="filter-label" for="timelineTypeFilter">Tipo:</label>
                            <select id="timelineTypeFilter" class="filter-input">
                                <option value="">Todos os Tipos</option>
                                <option value="AP">Alta Pressão</option>
                                <option value="AV">Auto Vácuo</option>
                                <option value="HP">Hiper Vácuo</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label class="filter-label" for="timelineStatusFilter">Status:</label>
                            <select id="timelineStatusFilter" class="filter-input">
                                <option value="">Todos</option>
                                <option value="normal">Normal</option>
                                <option value="irregular">Irregular</option>
                            </select>
                        </div>
                        <div class="filter-group" style="grid-column:1/-1">
                            <label class="filter-label" for="equipmentSelectorTimeline">Focar Equipamentos:</label>
                            <select id="equipmentSelectorTimeline" multiple class="filter-input"></select>
                        </div>
                        <div class="filter-group" style="grid-column:1/-1;text-align:center">
                            <button class="btn" onclick="clearTimelineSelection()">Limpar Seleção</button>
                        </div>
                    </div>
                    <div style="text-align:center;margin-top:20px">
                        <button class="btn btn-success" onclick="exportarTimelinePDF('selected')">Exportar Selecionados (PDF)</button>
                        <button class="btn" onclick="exportarTimelinePDF('all')">Exportar Visíveis (PDF)</button>
                    </div>
                </div>

                <div class="timeline-legend" id="timelineLegend"></div>
                <div id="timelineContainer">
                    <div class="timeline-empty">Carregue um arquivo CSV e processe os dados para visualizar a timeline inteligente.</div>
                </div>
            </section>
        </div>
    </div>

    <div class="footer">
        Desenvolvido por Warlison Abreu
    </div>

    <script>
        let dadosCSV = [];
        let equipamentosProcessados = {};
        let apontamentosIrregulares = [];
        let dadosFiltrados = [];
        let regimesDisponiveis = {};
        let regimeAtivo = null;
        let zoomLevel = 1;

        const CATEGORIA_CORES = {
            DEFAULT: '#7f8c8d',
            REFEIÇÃO: '#3498db',
            ABASTECIMENTO: '#f39c12',
            'MANUTENÇÃO CORRETIVA': '#e74c3c',
            'MANUTENÇÃO PREVENTIVA': '#d35400',
            DESLOCAMENTO: '#2ecc71',
            CHECKLIST: '#9b59b6',
            ESPERA: '#1abc9c',
            LIMPEZA: '#f1c40f'
        };

        const COLOR_PALETTE = ['#1abc9c','#3498db','#9b59b6','#e67e22','#e74c3c','#f1c40f','#2ecc71','#16a085','#27ae60','#2980b9','#8e44ad','#d35400','#c0392b','#7f8c8d'];
        let dynamicColorIndex = 0;

        // Definições de regimes de trabalho
        const REGIMES_CONFIG = {
            '24HS': {
                nome: '24 Horas',
                turnos: [
                    { nome: 'Turno A', inicio: '07:00', fim: '19:00' },
                    { nome: 'Turno B', inicio: '19:00', fim: '07:00' }
                ],
                identificadores: ['24 HS', '24HS', '24H']
            },
            '16HS': {
                nome: '16 Horas',
                turnos: [
                    { nome: 'Turno A', inicio: '07:00', fim: '15:00' },
                    { nome: 'Turno B', inicio: '15:00', fim: '23:00' },
                    { nome: 'Turno C', inicio: '23:00', fim: '07:00' }
                ],
