        function handleFile(file) {
            if(!file.name.endsWith('.csv')) {
                showError('Selecione um arquivo CSV válido.');
                return;
            }

            document.getElementById('uploadArea').innerHTML = '<div class="upload-text">Analisando ' + file.name + '...</div>';
            document.getElementById('processBtn').disabled = true;

            Papa.parse(file, {
                header: true,
                skipEmptyLines: true,
                delimiter: ';',
                complete: result => processarArquivoCarregado(result, file.name),
                error: error => {
                    showError('Erro ao ler CSV: ' + error.message);
                    resetUploadArea();
                }
            });
        }

        function resetUploadArea() {
            document.getElementById('uploadArea').innerHTML = '<div class="upload-text">Clique aqui ou arraste o arquivo CSV</div><div class="upload-subtext">Arquivo: Demoras Categorizadas (CSV)</div>';
        }

        function processarArquivoCarregado(result, fileName) {
            dadosCSV = result.data.filter(linha => 
                linha.Placa && linha.Vaga && linha['Categoria Demora'] && 
                linha['Data Inicial'] && linha['Data Final'] && 
                linha['Tempo Indisponível (HH:MM)']
            );

            if(!dadosCSV.length) {
                showError('Nenhum registro válido no CSV.');
                resetUploadArea();
                return;
            }

            document.getElementById('uploadArea').innerHTML = 
                '<div class="upload-text">' + fileName + '</div>' +
                '<div class="upload-subtext">' + dadosCSV.length + ' registros válidos.</div>';

            document.getElementById('processBtn').disabled = false;
            showSuccess('Arquivo carregado: ' + dadosCSV.length + ' registros prontos.');
        }

        function processarArquivo() {
            if(!dadosCSV.length) {
                showError('Nenhum dado para processar.');
                return;
            }

            document.getElementById('processBtn').textContent = 'Processando...';
            document.getElementById('processBtn').disabled = true;

            setTimeout(() => {
                try {
                    dadosFiltrados = [...dadosCSV];
                    
                    // Detectar regimes automaticamente
                    detectarRegimes(dadosFiltrados);
                    
                    // Nova lógica de detecção de irregularidades
                    detectarApontamentosIrregularesInteligente(dadosFiltrados);
                    
                    equipamentosProcessados = processarEquipamentosDoCSV(dadosFiltrados);
                    
                    exibirResultadosDashboard();
                    exibirRegimes();
                    atualizarLegendaTimeline();

                    if(document.querySelector('.tab-btn.active').getAttribute('onclick').includes('timeline')) {
                        gerarTimelineInteligente();
