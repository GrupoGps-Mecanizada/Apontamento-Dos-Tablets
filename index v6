        }

        function detectarRegimes(dados) {
            regimesDisponiveis = {};
            
            dados.forEach(apt => {
                const vaga = apt.Vaga;
                if(!vaga) return;

                let regime = 'ADM'; // Default
                
                // Detectar regime baseado na vaga
                Object.keys(REGIMES_CONFIG).forEach(key => {
                    REGIMES_CONFIG[key].identificadores.forEach(id => {
                        if(vaga.toUpperCase().includes(id)) {
                            regime = key;
                        }
                    });
                });

                if(!regimesDisponiveis[regime]) {
                    regimesDisponiveis[regime] = {
                        ...REGIMES_CONFIG[regime],
                        equipamentos: new Set(),
                        apontamentos: 0
                    };
                }

                const codigo = extrairCodigoVaga(vaga);
                if(codigo) {
                    regimesDisponiveis[regime].equipamentos.add(codigo);
                }
                regimesDisponiveis[regime].apontamentos++;
            });

            // Converter Sets para Arrays
            Object.keys(regimesDisponiveis).forEach(regime => {
                regimesDisponiveis[regime].equipamentos = Array.from(regimesDisponiveis[regime].equipamentos);
            });
        }

        function detectarApontamentosIrregularesInteligente(dados) {
            apontamentosIrregulares = [];
            const equipamentosContador = {};

            // Primeiro, contar apontamentos por equipamento
            dados.forEach(apt => {
                const codigo = extrairCodigoVaga(apt.Vaga);
                if(codigo) {
                    equipamentosContador[codigo] = (equipamentosContador[codigo] || 0) + 1;
                }
            });

            dados.forEach((apt, idx) => {
                const tempo = apt['Tempo Indisponível (HH:MM)'];
                const categoria = apt['Categoria Demora'];
                const minutos = tempoParaMinutos(tempo);
                const codigo = extrairCodigoVaga(apt.Vaga);
                const intervalo = extrairIntervaloTempo(apt['Data Inicial'], apt['Data Final']);
                const idxOriginal = dadosCSV.indexOf(apt);

                // 1. Apontamentos zerados
                if(minutos === 0) {
                    apontamentosIrregulares.push({
                        tipo: 'Apontamento Zerado',
                        descricao: `${codigo || 'N/D'} - ${categoria} 00:00`,
                        equipamento: codigo,
                        categoria: categoria,
                        tempo: tempo,
                        intervalo: intervalo,
                        gravidade: 'BAIXA',
                        index: idxOriginal
                    });
                }

                // 2. Apontamentos muito curtos (<=4 minutos)
                if(minutos > 0 && minutos <= 4) {
                    apontamentosIrregulares.push({
                        tipo: 'Apontamento Muito Curto',
                        descricao: `${codigo || 'N/D'} - ${categoria} de ${tempo}`,
                        equipamento: codigo,
                        categoria: categoria,
                        tempo: tempo,
                        intervalo: intervalo,
                        gravidade: 'BAIXA',
                        index: idxOriginal
                    });
                }

                // 3. Equipamentos com poucos apontamentos (<=3) - NOVA LÓGICA
                if(codigo && equipamentosContador[codigo] <= 3) {
                    // Marcar todos os apontamentos deste equipamento como irregulares
                    apontamentosIrregulares.push({
                        tipo: 'Equipamento com Poucos Apontamentos',
                        descricao: `${codigo} - Total de apenas ${equipamentosContador[codigo]} apontamento(s)`,
                        equipamento: codigo,
                        categoria: categoria,
                        tempo: tempo,
                        intervalo: intervalo,
                        gravidade: 'ALTA',
                        index: idxOriginal
                    });
                }
            });
        }

        function extrairCodigoVaga(nomeVaga) {
            if(!nomeVaga) return null;

            const nome = nomeVaga.toString().trim().toUpperCase();
            
            const patterns = [
                {regex: /CAMINHÃO ALTA PRESSÃO - GPS - (\d+)(?: - (16 HS|24 HS|ADM))?/, prefix: 'AP'},
                {regex: /CAMINHÃO AUTO VÁCUO - GPS - (\d+)(?: - (16 HS|24 HS|ADM))?/, prefix: 'AV'},
                {regex: /CAMINHÃO HIPER VÁCUO - GPS - (\d+)(?: - (16 HS|24 HS|ADM))?/, prefix: 'HP'}
            ];

            for(const pattern of patterns) {
                const match = nome.match(pattern.regex);
                if(match) {
                    const numero = match[1].padStart(2, '0');
                    let codigo = `${pattern.prefix}-${numero}`;
                    
                    if(match[2]) {
                        if(match[2] === '24 HS') codigo += ' - 24HS';
                        else if(match[2] === '16 HS') codigo += ' - 16HS';
                        else if(match[2] === 'ADM') codigo += ' - ADM';
                    }
                    
                    return codigo;
                }
            }

            return null;
        }

        function getTipoEquipamento(codigo) {
            if(!codigo) return 'UNKNOWN';
            if(codigo.startsWith('AP-')) return 'AP';
            if(codigo.startsWith('AV-')) return 'AV';
            if(codigo.startsWith('HP-')) return 'HP';
            return 'UNKNOWN';
        }

        function extrairIntervaloTempo(dataInicial, dataFinal) {
            if(!dataInicial || !dataFinal) return 'N/A';
            
            const horaInicial = extrairHora(dataInicial);
            const horaFinal = extrairHora(dataFinal);
            
            return horaInicial && horaFinal ? `${horaInicial} às ${horaFinal}` : horaInicial || horaFinal || 'N/A';
        }

        function parseDataHora(str) {
            if(!str) return null;
            const pattern = str.match(/(\d{2})\/(\d{2})\/(\d{4})\s*(\d{2}):(\d{2})(?::\d{2})?/);
            return pattern ? new Date(pattern[3], pattern[2]-1, pattern[1], pattern[4], pattern[5], 0) : null;
        }

        function processarEquipamentosDoCSV(apontamentos) {
            const equipamentos = {};
            const codigosUnicos = new Set(apontamentos.map(apt => extrairCodigoVaga(apt.Vaga)).filter(Boolean));

            codigosUnicos.forEach(codigo => {
                equipamentos[codigo] = {
                    codigo: codigo,
                    tipo: getTipoEquipamento(codigo),
                    totalApontamentos: 0,
                    apontamentos: [],
                    primeiroRegistro: null,
                    status: 'CRITICO'
                };
            });

            apontamentos.forEach((apt) => {
                const codigo = extrairCodigoVaga(apt.Vaga);
                if(!codigo || !equipamentos[codigo]) return;

                const equipamento = equipamentos[codigo];
                const indexOriginal = dadosCSV.indexOf(apt);

                const dataHoraInicio = parseDataHora(apt['Data Inicial']);
                const dataHoraFim = parseDataHora(apt['Data Final']);

                const objApontamento = {
                    categoria: apt['Categoria Demora'],
                    dataInicialOriginal: apt['Data Inicial'],
                    dataFinalOriginal: apt['Data Final'],
                    dataHoraInicio: dataHoraInicio,
                    dataHoraFim: dataHoraFim,
                    tempoIndisponivel: apt['Tempo Indisponível (HH:MM)'],
                    inicioHHMM: extrairHora(apt['Data Inicial']),
                    intervalo: extrairIntervaloTempo(apt['Data Inicial'], apt['Data Final']),
                    irregular: apontamentosIrregulares.some(irr => irr.index === indexOriginal)
                };

                equipamento.apontamentos.push(objApontamento);
                equipamento.totalApontamentos++;

                if(!equipamento.primeiroRegistro || 
                   (objApontamento.inicioHHMM && horaParaMinutos(objApontamento.inicioHHMM) < horaParaMinutos(equipamento.primeiroRegistro))) {
                    equipamento.primeiroRegistro = objApontamento.inicioHHMM;
                }
            });

            Object.values(equipamentos).forEach(equipamento => {
                equipamento.status = calcularStatusInteligente(equipamento);
            });

            return equipamentos;
        }

        function calcularStatusInteligente(equipamento) {
            const { totalApontamentos, primeiroRegistro, apontamentos } = equipamento;
            const irregulares = apontamentos.filter(apt => apt.irregular).length;

            // Nova lógica: equipamentos com 3 ou menos apontamentos são críticos
            if(totalApontamentos <= 3) return 'CRITICO';
            
            if(irregulares > totalApontamentos * 0.4) return 'CRITICO';
            
            if(irregulares > totalApontamentos * 0.2 || totalApontamentos < 6 || 
               (primeiroRegistro && horaParaMinutos(primeiroRegistro) > 540)) {
                return 'ATENCAO';
            }
            
            return 'BOM';
        }

        function extrairHora(timestamp) {
            if(!timestamp) return null;
            const match = timestamp.toString().match(/(\d{1,2}:\d{2}(?::\d{2})?)/);
            if(match && match[1]) {
                const [horas, minutos] = match[1].split(':');
                return `${horas.padStart(2, '0')}:${minutos.padStart(2, '0')}`;
            }
            return null;
        }

        const horaParaMinutos = hora => {
            if(!hora || !hora.includes(':')) return 1441;
            return hora.split(':').map(Number).reduce((acc, val, idx) => idx ? acc + val : acc + val * 60, 0);
        };

        const tempoParaMinutos = tempo => {
            if(!tempo || !tempo.includes(':')) return 0;
            return tempo.split(':').map(Number).reduce((acc, val, idx) => idx ? acc + val : acc + val * 60, 0);
        };

        function getCorCategoria(categoria) {
            const key = categoria.toUpperCase();
            if(!CATEGORIA_CORES[key]) {
                CATEGORIA_CORES[key] = COLOR_PALETTE[dynamicColorIndex % COLOR_PALETTE.length];
                dynamicColorIndex++;
            }
            return CATEGORIA_CORES[key];
        }

